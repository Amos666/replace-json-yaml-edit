{
  "name": "replace-json-yaml-edit",
  "displayName": "Batch Replace for JSON & YAML",
  "description": "Batch replace values across JSON, YAML and any text files by path or regex - preview every diff in a visual panel, apply to hundreds of files with one undo.",
  "version": "0.1.5",
  "publisher": "ghemail",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/Amos666/replace-json-yaml-edit.git"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "batch replace",
    "bulk replace",
    "replace in files",
    "replace across files",
    "multiple files",
    "multi-file",
    "batch edit",
    "replace all",
    "json",
    "jsonc",
    "yaml",
    "yml",
    "structured edit",
    "structured replace",
    "jsonpath",
    "key value",
    "sed",
    "regex",
    "find and replace",
    "diff",
    "preview",
    "workspace",
    "config",
    "批量替换",
    "批量修改",
    "多文件替换"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onCommand:structedit.openPanel",
    "onCommand:structedit.useCursorPath",
    "onCommand:structedit.useSelectionAsPattern",
    "onCommand:structedit.applyFile",
    "onCommand:structedit.showReport",
    "onCommand:structedit.selectAllMatches",
    "onCommand:structedit.sequentialReview",
    "onCommand:structedit.undoLast"
  ],
  "contributes": {
    "commands": [
      {
        "command": "structedit.openPanel",
        "title": "Batch Replace for JSON & YAML: Open Batch Edit Panel"
      },
      {
        "command": "structedit.useCursorPath",
        "title": "Batch Replace for JSON & YAML: Use Cursor Path"
      },
      {
        "command": "structedit.useSelectionAsPattern",
        "title": "Batch Replace for JSON & YAML: Use Selection as Pattern"
      },
      {
        "command": "structedit.applyFile",
        "title": "Batch Replace for JSON & YAML: Apply Expression Set File"
      },
      {
        "command": "structedit.showReport",
        "title": "Batch Replace for JSON & YAML: Show Last Report"
      },
      {
        "command": "structedit.selectAllMatches",
        "title": "Batch Replace for JSON & YAML: Select All Filter Matches"
      },
      {
        "command": "structedit.sequentialReview",
        "title": "Batch Replace for JSON & YAML: Review Matches One by One"
      },
      {
        "command": "structedit.undoLast",
        "title": "Batch Replace for JSON & YAML: 一键回退上次批量修改"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "structedit.openPanel",
          "group": "batchReplace@1"
        },
        {
          "command": "structedit.useCursorPath",
          "group": "batchReplace@2"
        },
        {
          "command": "structedit.useSelectionAsPattern",
          "group": "batchReplace@3"
        }
      ]
    },
    "keybindings": [
      {
        "command": "structedit.openPanel",
        "key": "ctrl+alt+b"
      },
      {
        "command": "structedit.undoLast",
        "key": "ctrl+alt+z"
      }
    ],
    "configuration": {
      "title": "Batch Replace for JSON & YAML",
      "properties": {
        "batchReplace.maxMatchesPerFile": {
          "type": "number",
          "default": 2000,
          "description": "Maximum number of matches produced by a single instruction in one file. Excess matches are truncated with a warning."
        },
        "batchReplace.maxFileSizeMB": {
          "type": "number",
          "default": 5,
          "description": "Files larger than this are skipped by the text engine."
        },
        "batchReplace.defaultExclude": {
          "type": "array",
          "items": { "type": "string" },
          "default": ["**/node_modules/**", "**/.git/**", "**/dist/**", "**/out/**", "**/.vscode-test/**"],
          "description": "Glob patterns excluded from the workspace file scan."
        },
        "batchReplace.maxFiles": {
          "type": "number",
          "default": 5000,
          "minimum": 100,
          "maximum": 20000,
          "description": "Maximum number of files pulled into the file tree. Lower this if opening the panel is slow on a very large workspace; use the filter box to narrow the range instead."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "compile": "tsc --noEmit",
    "test": "node --test test/**/*.test.ts",
    "package": "vsce package --no-dependencies",
    "test:integration:build": "node test/integration/build.mjs",
    "test:integration": "npm run build && npm run test:integration:build && node test/integration/run.cjs"
  },
  "dependencies": {
    "jsonc-parser": "3.3.1",
    "yaml": "2.9.1"
  },
  "devDependencies": {
    "@types/jsdom": "^30.0.0",
    "@types/node": "^22.15.0",
    "@types/vscode": "^1.85.0",
    "@vscode/codicons": "^0.0.46-24",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.25.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.7.3"
  }
}
